APP_NAME=skiptheline-api
APP_ENV=development
API_V1_PREFIX=/api/v1
# Neon / any PostgreSQL. "postgresql://" is accepted and rewritten to the psycopg driver.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/DBNAME?sslmode=require
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=30
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO
ENABLE_DOCS=true
# Set to false in development if you want to demo outside office hours.
ENFORCE_OFFICE_HOURS=false
RATE_LIMIT_ENABLED=true
# Seed script only (required unless APP_ENV=development)
# SEED_DEMO_PASSWORD=
